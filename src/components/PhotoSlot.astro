---
interface Props {
  label: string;
  shape?: 'rect' | 'circle';
  alt?: string;
  class?: string;
  style?: string;
}
const { label, shape = 'rect', alt, class: className, style } = Astro.props;
---
<div
  class:list={['photo-slot', shape === 'circle' && 'photo-slot--circle', className]}
  style={style}
  role="img"
  aria-label={alt ?? label}
>
  <span>{label}</span>
</div>
