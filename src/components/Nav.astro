---
interface Props {
  current: 'inicio' | 'nosotros' | 'apadrina' | 'voluntariado' | 'empresas';
}
const { current } = Astro.props;

const links = [
  { href: '/', key: 'inicio', label: 'Inicio' },
  { href: '/nosotros', key: 'nosotros', label: 'Nosotros' },
  { href: '/apadrina', key: 'apadrina', label: 'Apadrina' },
  { href: '/voluntariado', key: 'voluntariado', label: 'Voluntariado' },
  { href: '/empresas', key: 'empresas', label: 'Empresas' },
] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark">Ch</span>
      <span class="brand__name">ChiChiCa</span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          class={l.key === current ? 'navlink-active' : 'navlink'}
          aria-current={l.key === current ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <a href="/apadrina" class="nav-cta btn-cta">Hazte Padrino Hoy</a>

    <details class="nav-burger">
      <summary class="burger-btn" aria-label="Abrir menú">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>
      </summary>
      <div class="burger-menu">
        {links.map((l) => <a href={l.href} class="menu-item">{l.label}</a>)}
        <a href="/apadrina" class="menu-cta btn-cta">Hazte Padrino Hoy</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(32, 30, 29, 0.08);
  }
  .site-header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
    height: 72px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
  }
  .brand__mark {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-size: 17px;
  }
  .brand__name {
    font-family: var(--font-heading);
    font-size: 20px;
    letter-spacing: 0.2px;
  }
  .nav-links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 15px;
    font-weight: 600;
  }
  .navlink { color: var(--color-text); }
  .nav-cta {
    background: var(--color-accent);
    color: #fff;
    border-radius: 999px;
    padding: 12px 22px;
    font-size: 15px;
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }
  .nav-burger { display: none; position: relative; }
  .burger-btn {
    cursor: pointer;
    width: 44px; height: 44px;
    border-radius: 999px;
    background: var(--color-accent-100);
    color: var(--color-accent-700);
    display: grid;
    place-items: center;
  }
  .burger-menu {
    position: absolute;
    right: 0; top: 56px;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 230px;
  }
  .menu-item {
    padding: 11px 14px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
  }
  .menu-cta {
    margin-top: 10px;
    text-align: center;
    background: var(--color-accent);
    color: #fff;
    border-radius: 999px;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: 700;
  }
</style>
